# Server (copy to server/.env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/flight-delay
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_EXPIRES_IN=12h
CLIENT_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_KEY=change-me
AVIATIONSTACK_KEY=
AVIATIONSTACK_MONTHLY_LIMIT=100
ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ML service (copy to ml-service/.env)
INTERNAL_API_KEY=change-me
ARTIFACTS_DIR=./artifacts
PARQUET_DIR=../data/processed

# Client (copy to client/.env)
VITE_API_URL=http://localhost:5000
