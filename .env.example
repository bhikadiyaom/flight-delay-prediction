# ---------------------------------------------------------------------------------------------
# Variables for `docker compose up` (copy to .env in the repo root; compose reads it automatically).
# Running the services WITHOUT Docker uses the per-service files instead:
#   server/.env.example  ml-service/.env.example  client/.env.example   (scripts/setup.ps1 creates them for you)
# ---------------------------------------------------------------------------------------------

# REQUIRED. 32+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# REQUIRED. 16+ random characters. Shared secret between the Node server and the ML service (one value, used by both).
ML_INTERNAL_KEY=

# Comma separated emails that become admins when they register
ADMIN_EMAILS=

# Live flight data. Leave empty to run on built-in demo flights (the UI shows a "Demo data" badge).
AVIATIONSTACK_KEY=
AVIATIONSTACK_MONTHLY_LIMIT=100

# Ports published on the host
CLIENT_PORT=8080
SERVER_PORT=5000

# Browser-facing URLs. The client bakes SERVER_URL in at build time; the server allows CLIENT_URL for CORS.
CLIENT_URL=http://localhost:8080
SERVER_URL=http://localhost:5000

# Optional: alert emails (without SMTP_HOST they are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flight Delay Predictor <no-reply@example.com>

# Optional: historical analytics data for the ML service. The compose file mounts ./data/processed read-only.
# For hosts without that folder, set a download URL (see docs/deployment-guide.md) and its checksum.
PARQUET_URL=
PARQUET_SHA256=
# Use 300MB on a 512 MB host
DUCKDB_MEMORY_LIMIT=1GB
