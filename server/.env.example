# Copy to server/.env. The server refuses to start (listing what is wrong) if a required value is missing.
PORT=5000
NODE_ENV=development

# required
MONGODB_URI=mongodb://127.0.0.1:27017/flight-delay   # local: `npm run dev:db`; prod: MongoDB Atlas URI (URL-encode the password)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ML_INTERNAL_KEY=change-me-at-least-16-chars            # must equal ml-service INTERNAL_API_KEY

# auth
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
ADMIN_EMAILS=                                           # comma separated; these emails get role admin on register

# CORS allowlist, comma separated, exact origins, no trailing slash
CLIENT_URL=http://localhost:5173

# ml-service
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=15000

# live data (leave AVIATIONSTACK_KEY empty to run entirely on demo flights)
AVIATIONSTACK_KEY=
AVIATIONSTACK_MONTHLY_LIMIT=100
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1  # free tier is http only
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
UPSTREAM_TIMEOUT_MS=8000

# rate limits per 15 minutes
RATE_LIMIT_ANON=30
RATE_LIMIT_USER=120
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_AUTH=20

# risk alerts (email). Without SMTP_HOST, alert emails are logged instead of sent.
ALERTS_ENABLED=true
ALERTS_CRON=*/30 * * * *
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flight Delay Predictor <no-reply@example.com>
